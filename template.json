{
  "name": "Supabase Self-Hosted Backend",
  "description": "Postgres, auth, storage, realtime, edge functions and Studio in one stack.",
  "category": "Starters",
  "tags": [
    "supabase",
    "postgres",
    "auth",
    "storage",
    "realtime",
    "edge-functions",
    "baas",
    "firebase-alternative"
  ],
  "upstream": {
    "repo": "supabase/supabase (docker/)",
    "version": "self-hosted/v0.8.2",
    "checked": "2026-10-10"
  },
  "services": {
    "Postgres": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "source": {
        "repo": "baranberkay96/supabase-railway",
        "rootDirectory": "/services/postgres"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/var/lib/postgresql/data"
      },
      "variables": {
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Password of supabase_admin and of every Supabase role (postgres, authenticator, supabase_auth_admin, ...). Set once: changing it later does not update the roles.",
          "required": false
        },
        "POSTGRES_USER": {
          "defaultValue": "supabase_admin",
          "description": "Bootstrap superuser of the Supabase image. Must stay supabase_admin.",
          "required": false
        },
        "POSTGRES_DB": {
          "defaultValue": "postgres",
          "description": "Main database name (Supabase expects postgres).",
          "required": false
        },
        "POSTGRES_PORT": {
          "defaultValue": "5432",
          "description": "Port used by the image's init scripts.",
          "required": false
        },
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Cluster directory inside the volume.",
          "required": false
        },
        "PGHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Private host (Railway Data panel).",
          "required": false
        },
        "PGPORT": {
          "defaultValue": "5432",
          "description": "Postgres port.",
          "required": false
        },
        "PGUSER": {
          "defaultValue": "postgres",
          "description": "User for the Railway Data panel and app connections.",
          "required": false
        },
        "PGPASSWORD": {
          "defaultValue": "${{POSTGRES_PASSWORD}}",
          "description": "Password for PGUSER.",
          "required": false
        },
        "PGDATABASE": {
          "defaultValue": "${{POSTGRES_DB}}",
          "description": "Database for the Railway Data panel.",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "postgresql://postgres:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{POSTGRES_DB}}",
          "description": "Direct private connection string (user postgres).",
          "required": false
        },
        "JWT_EXP": {
          "defaultValue": "${{Gateway.JWT_EXPIRY}}",
          "description": "JWT lifetime stored as app.settings.jwt_exp on first init.",
          "required": false
        },
        "PGSODIUM_ROOT_KEY": {
          "defaultValue": "${{secret(64, \"0123456789abcdef\")}}",
          "description": "pgsodium/Vault root key (64 hex). Never change or lose it: Vault secrets become unreadable.",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Allow Postgres to shut down cleanly on redeploy.",
          "required": false
        }
      }
    },
    "Gateway": {
      "icon": "https://cdn.simpleicons.org/envoyproxy/AC6199",
      "source": {
        "repo": "baranberkay96/supabase-railway",
        "rootDirectory": "/services/api-gateway"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/health",
      "healthcheckTimeout": 300,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": true,
      "targetPort": 8000,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "8000",
          "description": "Port Envoy listens on (public domain target).",
          "required": false
        },
        "SUPABASE_PUBLIC_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL of your Supabase project (API + Studio). Change to https://your-domain after adding a custom domain.",
          "required": false
        },
        "JWT_SECRET": {
          "defaultValue": "${{secret(64, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Project JWT secret. ANON_KEY and SERVICE_ROLE_KEY are derived from it; changing it rotates both and signs everyone out.",
          "required": false
        },
        "JWT_EXPIRY": {
          "defaultValue": "3600",
          "description": "Access token lifetime in seconds.",
          "required": false
        },
        "ANON_KEY": {
          "defaultValue": "",
          "description": "Optional. Leave empty to derive the anon key from JWT_SECRET (recommended). Set only to pin an existing key.",
          "required": false
        },
        "SERVICE_ROLE_KEY": {
          "defaultValue": "",
          "description": "Optional. Leave empty to derive the service_role key from JWT_SECRET (recommended).",
          "required": false
        },
        "DASHBOARD_USERNAME": {
          "defaultValue": "supabase",
          "description": "Studio basic-auth username (letters, digits, . _ -).",
          "required": false
        },
        "DASHBOARD_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Studio basic-auth password (generated).",
          "required": false
        },
        "AUTH_HOST": {
          "defaultValue": "${{Auth.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Private host of the Auth service.",
          "required": false
        },
        "REST_HOST": {
          "defaultValue": "${{REST.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Private host of PostgREST.",
          "required": false
        },
        "REALTIME_HOST": {
          "defaultValue": "${{Realtime.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Private host of Realtime.",
          "required": false
        },
        "STORAGE_HOST": {
          "defaultValue": "${{Storage.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Private host of Storage.",
          "required": false
        },
        "FUNCTIONS_HOST": {
          "defaultValue": "${{Functions.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Private host of Edge Functions.",
          "required": false
        },
        "META_HOST": {
          "defaultValue": "${{Meta.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Private host of postgres-meta.",
          "required": false
        },
        "STUDIO_HOST": {
          "defaultValue": "${{Studio.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Private host of Studio.",
          "required": false
        },
        "SUPABASE_PUBLISHABLE_KEY": {
          "defaultValue": "",
          "description": "Optional new-style sb_publishable_ key (see README, new API keys). Empty = legacy keys only.",
          "required": false
        },
        "SUPABASE_SECRET_KEY": {
          "defaultValue": "",
          "description": "Optional new-style sb_secret_ key. Empty = legacy keys only.",
          "required": false
        },
        "ANON_KEY_ASYMMETRIC": {
          "defaultValue": "",
          "description": "Optional ES256 anon JWT used internally for sb_ key translation.",
          "required": false
        },
        "SERVICE_ROLE_KEY_ASYMMETRIC": {
          "defaultValue": "",
          "description": "Optional ES256 service_role JWT used internally for sb_ key translation.",
          "required": false
        }
      }
    },
    "Studio": {
      "icon": "https://cdn.simpleicons.org/supabase/3FCF8E",
      "source": {
        "repo": "baranberkay96/supabase-railway",
        "rootDirectory": "/services/studio"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/api/platform/profile",
      "healthcheckTimeout": 300,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/app/snippets"
      },
      "variables": {
        "PORT": {
          "defaultValue": "3000",
          "description": "Studio port (reached through the Gateway only).",
          "required": false
        },
        "HOSTNAME": {
          "defaultValue": "::",
          "description": "Listen on all IPv4/IPv6 interfaces.",
          "required": false
        },
        "STUDIO_PG_META_URL": {
          "defaultValue": "http://${{Meta.RAILWAY_PRIVATE_DOMAIN}}:8080",
          "description": "postgres-meta URL (private).",
          "required": false
        },
        "POSTGRES_HOST": {
          "defaultValue": "${{Postgres.RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Postgres host (private).",
          "required": false
        },
        "POSTGRES_PORT": {
          "defaultValue": "5432",
          "description": "Postgres port.",
          "required": false
        },
        "POSTGRES_DB": {
          "defaultValue": "${{Postgres.POSTGRES_DB}}",
          "description": "Postgres database.",
          "required": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{Postgres.POSTGRES_PASSWORD}}",
          "description": "Postgres password.",
          "required": false
        },
        "POSTGRES_USER_READ_WRITE": {
          "defaultValue": "postgres",
          "description": "Role Studio uses for read/write queries.",
          "required": false
        },
        "PG_META_CRYPTO_KEY": {
          "defaultValue": "${{Meta.CRYPTO_KEY}}",
          "description": "Shared key for encrypted connection strings between Studio and postgres-meta.",
          "required": false
        },
        "PGRST_DB_SCHEMAS": {
          "defaultValue": "${{REST.PGRST_DB_SCHEMAS}}",
          "description": "Schemas exposed by the REST API (mirrors PostgREST).",
          "required": false
        },
        "PGRST_DB_MAX_ROWS": {
          "defaultValue": "${{REST.PGRST_DB_MAX_ROWS}}",
          "description": "Max rows per REST request (mirrors PostgREST).",
          "required": false
        },
        "PGRST_DB_EXTRA_SEARCH_PATH": {
          "defaultValue": "${{REST.PGRST_DB_EXTRA_SEARCH_PATH}}",
          "description": "Extra search_path (mirrors PostgREST).",
          "required": false
        },
        "DEFAULT_ORGANIZATION_NAME": {
          "defaultValue": "Default Organization",
          "description": "Organization name shown in Studio.",
          "required": false
        },
        "DEFAULT_PROJECT_NAME": {
          "defaultValue": "Default Project",
          "description": "Project name shown in Studio.",
          "required": false
        },
        "OPENAI_API_KEY": {
          "defaultValue": "",
          "description": "Optional. Enables the Studio AI assistant.",
          "required": false
        },
        "SUPABASE_URL": {
          "defaultValue": "http://${{Gateway.RAILWAY_PRIVATE_DOMAIN}}:8000",
          "description": "Gateway URL on the private network.",
          "required": false
        },
        "SUPABASE_PUBLIC_URL": {
          "defaultValue": "${{Gateway.SUPABASE_PUBLIC_URL}}",
          "description": "Public project URL.",
          "required": false
        },
        "JWT_SECRET": {
          "defaultValue": "${{Gateway.JWT_SECRET}}",
          "description": "JWT secret (API keys are derived from it at start).",
          "required": false
        },
        "AUTH_JWT_SECRET": {
          "defaultValue": "${{Gateway.JWT_SECRET}}",
          "description": "JWT secret used by Studio to verify tokens.",
          "required": false
        },
        "ANON_KEY": {
          "defaultValue": "${{Gateway.ANON_KEY}}",
          "description": "Pinned anon key, if any (empty = derived).",
          "required": false
        },
        "SERVICE_ROLE_KEY": {
          "defaultValue": "${{Gateway.SERVICE_ROLE_KEY}}",
          "description": "Pinned service_role key, if any (empty = derived).",
          "required": false
        },
        "SUPABASE_PUBLISHABLE_KEY": {
          "defaultValue": "${{Gateway.SUPABASE_PUBLISHABLE_KEY}}",
          "description": "Optional new-style publishable key.",
          "required": false
        },
        "SUPABASE_SECRET_KEY": {
          "defaultValue": "${{Gateway.SUPABASE_SECRET_KEY}}",
          "description": "Optional new-style secret key.",
          "required": false
        },
        "ENABLED_FEATURES_LOGS_ALL": {
          "defaultValue": "false",
          "description": "Logs Explorer needs Logflare + Vector, which this template does not run.",
          "required": false
        },
        "SNIPPETS_MANAGEMENT_FOLDER": {
          "defaultValue": "/app/snippets",
          "description": "SQL snippets folder (on the volume).",
          "required": false
        }
      }
    },
    "Auth": {
      "icon": "https://cdn.simpleicons.org/supabase/3FCF8E",
      "source": {
        "image": "supabase/gotrue:v2.196.0"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/health",
      "healthcheckTimeout": 1200,
      "restartPolicyType": "ALWAYS",
      "restartPolicyMaxRetries": 0,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "9999",
          "description": "Auth port.",
          "required": false
        },
        "GOTRUE_API_HOST": {
          "defaultValue": "::",
          "description": "Listen on all IPv4/IPv6 interfaces.",
          "required": false
        },
        "GOTRUE_API_PORT": {
          "defaultValue": "9999",
          "description": "Auth port.",
          "required": false
        },
        "API_EXTERNAL_URL": {
          "defaultValue": "${{Gateway.SUPABASE_PUBLIC_URL}}/auth/v1",
          "description": "Public URL of the Auth API (OAuth callbacks, email links).",
          "required": false
        },
        "GOTRUE_DB_DRIVER": {
          "defaultValue": "postgres",
          "description": "Database driver.",
          "required": false
        },
        "GOTRUE_DB_DATABASE_URL": {
          "defaultValue": "postgres://supabase_auth_admin:${{Postgres.POSTGRES_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.POSTGRES_DB}}",
          "description": "Auth database connection (private).",
          "required": false
        },
        "GOTRUE_SITE_URL": {
          "defaultValue": "${{Gateway.SUPABASE_PUBLIC_URL}}",
          "description": "Your app's URL: default redirect after sign-up/sign-in. Set this to your frontend URL.",
          "required": false
        },
        "GOTRUE_URI_ALLOW_LIST": {
          "defaultValue": "",
          "description": "Comma-separated extra redirect URLs allowed after auth (e.g. http://localhost:3000/**).",
          "required": false
        },
        "GOTRUE_DISABLE_SIGNUP": {
          "defaultValue": "false",
          "description": "Set true to allow only invited/admin-created users.",
          "required": false
        },
        "GOTRUE_JWT_ADMIN_ROLES": {
          "defaultValue": "service_role",
          "description": "Roles allowed to use the admin API.",
          "required": false
        },
        "GOTRUE_JWT_AUD": {
          "defaultValue": "authenticated",
          "description": "JWT audience.",
          "required": false
        },
        "GOTRUE_JWT_DEFAULT_GROUP_NAME": {
          "defaultValue": "authenticated",
          "description": "Default role for signed-in users.",
          "required": false
        },
        "GOTRUE_JWT_EXP": {
          "defaultValue": "${{Gateway.JWT_EXPIRY}}",
          "description": "Access token lifetime (s).",
          "required": false
        },
        "GOTRUE_JWT_SECRET": {
          "defaultValue": "${{Gateway.JWT_SECRET}}",
          "description": "JWT signing secret (HS256).",
          "required": false
        },
        "GOTRUE_JWT_ISSUER": {
          "defaultValue": "${{API_EXTERNAL_URL}}",
          "description": "JWT issuer.",
          "required": false
        },
        "GOTRUE_EXTERNAL_EMAIL_ENABLED": {
          "defaultValue": "true",
          "description": "Enable email/password sign-in.",
          "required": false
        },
        "GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED": {
          "defaultValue": "false",
          "description": "Enable anonymous sign-ins.",
          "required": false
        },
        "GOTRUE_MAILER_AUTOCONFIRM": {
          "defaultValue": "true",
          "description": "Auto-confirm email sign-ups. Keep true until SMTP is configured, then set false to require email confirmation.",
          "required": false
        },
        "GOTRUE_SMTP_ADMIN_EMAIL": {
          "defaultValue": "",
          "description": "Sender address for auth emails (needed once SMTP is configured).",
          "required": false
        },
        "GOTRUE_SMTP_HOST": {
          "defaultValue": "",
          "description": "SMTP host for confirmation/recovery emails. Empty = auth emails are not delivered.",
          "required": false
        },
        "GOTRUE_SMTP_PORT": {
          "defaultValue": "587",
          "description": "SMTP port.",
          "required": false
        },
        "GOTRUE_SMTP_USER": {
          "defaultValue": "",
          "description": "SMTP username.",
          "required": false
        },
        "GOTRUE_SMTP_PASS": {
          "defaultValue": "",
          "description": "SMTP password.",
          "required": false
        },
        "GOTRUE_SMTP_SENDER_NAME": {
          "defaultValue": "Supabase",
          "description": "Sender display name.",
          "required": false
        },
        "GOTRUE_MAILER_URLPATHS_INVITE": {
          "defaultValue": "/auth/v1/verify",
          "description": "Invite link path.",
          "required": false
        },
        "GOTRUE_MAILER_URLPATHS_CONFIRMATION": {
          "defaultValue": "/auth/v1/verify",
          "description": "Confirmation link path.",
          "required": false
        },
        "GOTRUE_MAILER_URLPATHS_RECOVERY": {
          "defaultValue": "/auth/v1/verify",
          "description": "Recovery link path.",
          "required": false
        },
        "GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE": {
          "defaultValue": "/auth/v1/verify",
          "description": "Email-change link path.",
          "required": false
        },
        "GOTRUE_EXTERNAL_PHONE_ENABLED": {
          "defaultValue": "false",
          "description": "Phone sign-in (needs an SMS provider; see Supabase docs).",
          "required": false
        },
        "GOTRUE_SMS_AUTOCONFIRM": {
          "defaultValue": "false",
          "description": "Auto-confirm phone sign-ups.",
          "required": false
        }
      }
    },
    "REST": {
      "icon": "https://avatars.githubusercontent.com/u/15115011",
      "source": {
        "image": "postgrest/postgrest:v14.17"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/",
      "healthcheckTimeout": 1200,
      "restartPolicyType": "ALWAYS",
      "restartPolicyMaxRetries": 0,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "3000",
          "description": "PostgREST port.",
          "required": false
        },
        "PGRST_SERVER_HOST": {
          "defaultValue": "*",
          "description": "Listen on all IPv4/IPv6 interfaces.",
