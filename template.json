        },
        "PGRST_ADMIN_SERVER_PORT": {
          "defaultValue": "3001",
          "description": "Admin/health server port (container-local).",
          "required": false
        },
        "PGRST_ADMIN_SERVER_HOST": {
          "defaultValue": "localhost",
          "description": "Admin server bind address.",
          "required": false
        }
      }
    },
    "Realtime": {
      "icon": "https://cdn.simpleicons.org/supabase/3FCF8E",
      "source": {
        "image": "supabase/realtime:v2.134.10"
      },
      "startCommand": null,
      "preDeployCommand": null,
      "healthcheckPath": "/healthcheck",
      "healthcheckTimeout": 1200,
      "restartPolicyType": "ALWAYS",
      "restartPolicyMaxRetries": 0,
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "4000",
          "description": "Realtime port.",
          "required": false
        },
        "DB_HOST": {
          "defaultValue": "${{Postgres.RAILWAY_PRIVATE_DOMAIN}}",
