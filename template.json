        },
        "PGRST_DB_URI": {
          "defaultValue": "postgres://authenticator:${{Postgres.POSTGRES_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.POSTGRES_DB}}",
          "description": "Database connection as the authenticator role (private).",
          "required": false
        },
        "PGRST_DB_SCHEMAS": {
          "defaultValue": "public,graphql_public",
          "description": "Schemas exposed via the REST API.",
          "required": false
        },
        "PGRST_DB_MAX_ROWS": {
          "defaultValue": "1000",
          "description": "Max rows returned per request.",
          "required": false
        },
        "PGRST_DB_EXTRA_SEARCH_PATH": {
          "defaultValue": "public",
          "description": "Extra schemas on every request's search_path.",
